+/* ---- Briks: comandos de fora e texto selecionavel ---- */
+
+void cui_edit_command(cui_ctx *ui, cui_id id, cui_edit_cmd cmd) { ui->edit_cmd_id = id; ui->edit_cmd = (int)cmd; cui_request_redraw(ui); }
+
+bool cui_edit_focused(cui_ctx *ui, cui_id id) { return id && ui->focus == id; }
+
+bool cui_edit_selection(cui_ctx *ui, cui_id id, int *s0, int *s1, bool *can_undo, bool *can_redo) {
+    cui_edit_state *e = cui_state(ui, id, sizeof *e);
+    if (!e || !e->init) return false;
+    if (s0) *s0 = CUI_MIN(e->cursor, e->anchor);
+    if (s1) *s1 = CUI_MAX(e->cursor, e->anchor);
+    /* sem entrada "atual" gravada, o estado atual ainda pode ser desfeito se houver historico */
+    if (can_undo) *can_undo = e->undo_count > 0 && (e->undo_pos > 0 || e->undo_pos == e->undo_count);
+    if (can_redo) *can_redo = e->undo_pos + 1 < e->undo_count;
+    return true;
+}
+
+typedef struct { const char *buf; int len, s0, s1; cui_font font; float size, line_h; cui_color sel; bool focused; } cui__sel_paint;
+
+static void cui__paint_selectable(cui_ctx *ui, cui_node *n, void *data) {
+    cui__sel_paint *p = data;
+    if (!p->focused || p->s1 <= p->s0) return;
+    cui_rect r = n->rect;
+    cui_text_layout_line *lines;
+    int nl = cui__edit_lines(ui, p->font, p->size, p->buf, p->len, r.w, &lines);
+    bool unshaped = ui->text_unshaped;
+    ui->text_unshaped = true;
+    for (int k = 0; k < nl; k++) {
+        cui_text_layout_line *L = &lines[k];
+        int a0 = CUI_MAX(p->s0, L->start), a1 = CUI_MIN(p->s1, L->end);
+        bool extends = p->s1 > L->end && k < nl - 1;
+        if (!(a1 > a0 || (extends && a0 <= L->end && p->s0 <= L->end))) continue;
+        const char *line = p->buf + L->start;
+        float xa = cui__text_width(ui, p->font, p->size, line, a0 - L->start, false);
+        float xb = cui__text_width(ui, p->font, p->size, line, CUI_MAX(a1, a0) - L->start, false) + (extends ? 4 : 0);
+        cui_rect sr = { r.x + xa, r.y + p->line_h * (float)k, xb - xa, p->line_h };
+        cui_draw_rect(ui, sr, CUI_CORNERS(2), p->sel);
+    }
+    ui->text_unshaped = unshaped;
+}
+
+void cui_selectable_text_ex(cui_ctx *ui, const char *id_str, const char *text, const cui_selectable_opts *o) {
+    cui_selectable_opts d;
+    memset(&d, 0, sizeof d);
+    if (!o) o = &d;
+    if (!text) text = "";
+    cui_id id = cui_make_id(ui, id_str);
+    cui_id area_id = id ^ 0xED17u;
+    int len = (int)strlen(text);
+    char *buf = cui__frame_strdup(ui, text, len);
+    cui_edit_state *e = cui_state(ui, id, sizeof *e);
+    if (!e->init) { e->init = true; e->preferred_x = -1; cui__state_set_dtor(ui, id, cui__edit_dtor); }
+    float size = cui__fs(ui, o->size > 0 ? o->size : ui->theme.text_body);
+    float line_h = size * 1.45f;
+    cui_interact rf = cui__interact(ui, id, CUI_IF_DRAG | CUI_IF_TEXT | CUI_IF_KEEP_FOCUS);
+    if (rf.hovered) cui__set_cursor(ui, CUI_CURSOR_TEXT);
+    if (rf.hovered && ui->mpressed[CUI_MOUSE_LEFT]) { ui->focus = id; ui->focus_visible = false; }   /* fora da ordem do Tab, mas recebe foco ao clicar */
+    cui_rect area = cui__prev_rect(ui, area_id);
+    if (len > 0) cui__edit_logic(ui, id, e, buf, (size_t)len + 1, true, false, true, area, CUI_FONT_BODY, size, line_h, rf);
+    else if (ui->focus == id) e->cursor = e->anchor = 0;
+    int box = cui__node_new(ui, id);
+    cui_node *bn = &ui->nodes[box];
+    bn->dir = CUI_COLUMN;
+    cui__mark_interactive(ui, box, 0);
+    cui__open(ui, box);
+    cui_color col = cui__color_set(o->color) ? cui_color_of(ui, o->color) : CUI_C(ui, FOREGROUND);
+    int t = cui__text_node(ui, text, len, CUI_FONT_BODY, size, col, true);
+    ui->nodes[t].id = area_id;
+    if (o->max_width > 0) ui->nodes[t].max_w = o->max_width;
+    cui__close(ui);
+    cui__sel_paint *p = cui__frame_alloc(ui, sizeof *p);
+    p->buf = buf; p->len = len; p->s0 = CUI_MIN(e->cursor, e->anchor); p->s1 = CUI_MAX(e->cursor, e->anchor);
+    p->font = CUI_FONT_BODY; p->size = size; p->line_h = line_h; p->focused = ui->focus == id;
+    p->sel = ui->accent == CUI_ACCENT_NEUTRAL ? cui_alpha(cui_oklch(0.6f, 0.13f, 250, 1), 0.35f) : cui_alpha(CUI_C(ui, ACCENT), 0.38f);
+    ui->nodes[box].paint_data = p;
+    ui->nodes[box].paint = cui__paint_selectable;
+    ui->nodes[box].flags |= CUI_NF_PAINT_AFTER;
+    ui->last_id = id;
+}
