+/* Briks: comando do menu de contexto (cui_edit_command); roda no campo focado, como se fosse o atalho de teclado */
+static void cui__edit_command_run(cui__edit_frame *c, cui__edit_result *res) {
+    cui_ctx *ui = c->ui;
+    cui_edit_state *e = c->e;
+    if (!ui->edit_cmd || ui->edit_cmd_id != ui->focus) return;
+    int cmd = ui->edit_cmd;
+    ui->edit_cmd = 0;
+    int s0 = CUI_MIN(e->cursor, e->anchor), s1 = CUI_MAX(e->cursor, e->anchor);
+    if (cmd == CUI_EDIT_SELECT_ALL) { e->anchor = 0; e->cursor = c->len; c->moved = true; }
+    else if ((cmd == CUI_EDIT_COPY || cmd == CUI_EDIT_CUT) && s1 > s0 && !c->password) {
+        if (ui->platform.set_clipboard) ui->platform.set_clipboard(ui->platform.user, cui__frame_strdup(ui, c->buf + s0, s1 - s0));
+        if (cmd == CUI_EDIT_CUT && !c->read_only) {
+            cui__undo_push(ui, e, c->buf);
+            cui__delete_range(c->buf, &c->len, s0, s1);
+            e->cursor = e->anchor = s0;
+            c->edited = true;
+        }
+    } else if (cmd == CUI_EDIT_PASTE && !c->read_only && ui->platform.get_clipboard) {
+        const char *clip = ui->platform.get_clipboard(ui->platform.user);
+        if (clip && *clip) {
+            cui__undo_push(ui, e, c->buf);
+            cui__edit_replace_selection(c, clip, (int)strlen(clip), c->multiline);
+            e->last_edit = 0;
+        }
+    } else if ((cmd == CUI_EDIT_UNDO || cmd == CUI_EDIT_REDO) && !c->read_only) {
+        if (cui__edit_undo_step(ui, e, c->buf, c->cap, cmd == CUI_EDIT_REDO)) { c->len = (int)strlen(c->buf); res->changed = true; }
+    }
+}
