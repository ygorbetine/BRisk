{
  "name": "@briks/desktop",
  "version": "0.7.0",
  "private": true,
  "description": "Transmissão de tela e chamadas P2P com áudio, vídeo e chat via WebRTC",
  "homepage": "https://github.com/ygorbetine/BRisk",
  "author": {
    "name": "Briks",
    "email": "ygorbetine@users.noreply.github.com"
  },
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/prepare-desktop-backend.mjs --debug && concurrently -k \"pnpm --filter @briks/web dev\" \"wait-on http://localhost:5173 && tsc && electron .\"",
    "build": "tsc && electron-builder",
    "build:win": "tsc && electron-builder --win nsis",
    "build:linux": "tsc && electron-builder --linux AppImage deb",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "concurrently": "^9.1.2",
    "electron": "43.4.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.briks.calls",
    "productName": "Briks",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main.js",
      "dist/preload.cjs",
      "dist/backend.js",
      "dist/desktop-lifecycle.js",
      "dist/gpu.js",
      "dist/ipc/index.js",
      "dist/network-interfaces.js",
      "dist/permissions.js",
      "dist/protocol.js",
      "dist/screen-capture.js",
      "dist/tray.js",
      "dist/window.js"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/backend",
        "to": "backend",
        "filter": [
          "briks-desktop-backend",
          "briks-desktop-backend.exe"
        ]
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "../../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../../LICENSES",
        "to": "LICENSES",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "executableName": "briks",
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "maintainer": "Briks <ygorbetine@users.noreply.github.com>",
      "artifactName": "Briks-${version}-${arch}.${ext}"
    }
  }
}
