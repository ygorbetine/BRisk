{
  "name": "briks-p2p",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter @briks/web dev",
    "dev:web": "pnpm --filter @briks/web dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @briks/web build",
    "build:backend:desktop": "node scripts/prepare-desktop-backend.mjs",
    "build:backend:desktop:debug": "node scripts/prepare-desktop-backend.mjs --debug",
    "verify:build-env": "node scripts/verify-build-env.mjs",
    "verify:turn-config": "node scripts/verify-turn-config.mjs",
    "verify:migrations": "node scripts/verify-migration-integrity.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build:cui": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-cui.ps1"
  }
}
